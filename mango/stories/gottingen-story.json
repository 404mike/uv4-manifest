      "label": {
        "en": [
          "The Gänseliesel fountain"
        ]
      },
      "summary": {
        "en": [
          "Under the wrought-iron canopy stands the Gänseliesel, the goose girl. Doctoral graduates in Göttingen traditionally climb up to kiss her, which has earned the figure a reputation as one of the most kissed statues anywhere."
        ]
      },
